<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.message-center.device-runtime</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/path/to/message-center/bridge/device-runtime/device_runtime.py</string>
    <string>/path/to/private/runtime-config.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/message-center/bridge/device-runtime</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/path/to/private/logs/device-runtime.out.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/private/logs/device-runtime.err.log</string>
</dict>
</plist>
