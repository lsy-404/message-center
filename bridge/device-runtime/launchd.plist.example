<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.message-center.device-runtime</string>
  <key>ProgramArguments</key>
  <array>
    <string>/var/jb/usr/local/libexec/message-center/native-runtime-launcher</string>
    <string>/var/jb/usr/bin/python3</string>
    <string>/var/mobile/Library/MessageCenter/device_runtime.py</string>
    <string>/var/mobile/Library/MessageCenter/private-config.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/var/mobile/Library/MessageCenter</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>Nice</key>
  <integer>10</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/mobile/Library/MessageCenter/runtime.log</string>
  <key>StandardErrorPath</key>
  <string>/var/mobile/Library/MessageCenter/runtime-error.log</string>
</dict>
</plist>
